generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
}

enum CommissionFrequency {
  MONTHLY
  QUARTERLY
  ONE_TIME
  /// Settled twice a month, for the 1st-15th and 16th-end-of-month periods
  /// (a seller invoicing their own commission + moms, rather than being on
  /// payroll) - see getSemiMonthlyPeriod in commission.ts.
  SEMI_MONTHLY
}

enum ImportType {
  MANUAL
  CSV
  GOOGLE_DOCS
}

enum DealStage {
  LEAD
  CONTACTED
  MEETING_BOOKED
  FOLLOW_UP
  CONTRACT_SENT
  CONTRACT_SIGNED
  FILMED
  LIVE
  LOST
}

enum NoteKind {
  MANUAL
  AI_MEETING
  AI_EMAIL
}

enum GoalMetric {
  MEETINGS_BOOKED
  ESTABLISHMENT_FEE
  MRR_SOLD
  DEALS_SOLD
}

enum CommissionStatus {
  PENDING
  DUE
  PAID
}

enum EmailProvider {
  GOOGLE
  MICROSOFT
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum ContractStatus {
  NONE
  SENT
  VIEWED
  SIGNED
  DECLINED
  VOIDED
}

enum InvoiceStatus {
  PENDING
  DRAFT_CREATED
  FAILED
  /// Historical period from before the deal was imported into the CRM -
  /// already handled by the previous system, intentionally not drafted in Dinero.
  IMPORTED
  /// A seller sent this one by hand (outside Dinero-kladden), so the
  /// automated generator must never touch it either.
  SENT_MANUALLY
}

/// How often a customer's visitor-stats report (see CustomerReport) goes out
/// automatically. Null on the deal itself means reporting is off for that deal.
enum ReportInterval {
  MONTHLY
  BIMONTHLY
  QUARTERLY
}

enum ReportSendMethod {
  MANUAL
  AUTOMATIC
}

/// Language the visitor-stats report (email + PDF) is written in. Defaults
/// to Danish for every deal; set per customer when they need it in English.
enum ReportLanguage {
  DA
  EN
}

enum ReportSendStatus {
  /// A manual send's row is created with this status immediately (before the
  /// background job even starts), so the UI has something real in the
  /// database to show a loading state from - not just client-side component
  /// state that vanishes the moment the (now near-instant) action returns.
  PENDING
  SENT
  FAILED
}


model Invoice {
  id     String @id @default(cuid())
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String

  termNumber    Int           @default(1)
  /// 0 = one-time establishment fee for this term, 1+ = recurring quarter number
  quarterIndex  Int
  amount        Int
  scheduledDate DateTime
  status        InvoiceStatus @default(PENDING)

  dineroInvoiceGuid   String? @unique
  dineroInvoiceNumber String?
  failureReason       String?

  /// Set once Dinero reports the sent invoice as paid - checked on demand,
  /// not automatically, since most invoices sit as unsent drafts and have
  /// nothing to check yet.
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealId, termNumber, quarterIndex])
}

model User {
  id                String              @id @default(cuid())
  name              String
  email             String              @unique
  passwordHash      String
  role              Role                @default(SALES)
  isCommissionBased Boolean             @default(true)
  commissionRate    Float               @default(10)
  payoutFrequency   CommissionFrequency @default(MONTHLY)
  /// Profile picture as a data URL (small, resized client-side before upload).
  avatarUrl         String?
  /// Shown as the seller's contact phone on generated contracts.
  phone             String?
  /// Shown together with `name` as the seller's full name on generated contracts.
  lastName          String?
  /// Updated (throttled - see touchLastActive in auth.ts) whenever the user
  /// makes an authenticated request, not just at login - sessions last 30
  /// days, so "last login" would barely ever change and say very little
  /// about who's actually using the CRM day to day.
  lastActiveAt      DateTime?
  createdAt         DateTime            @default(now())
  /// When this user last opened /nyheder - posts created after this are
  /// counted as unread for the little badge on the news icon. Null means
  /// "never opened it", so every post ever made counts as unread.
  newsReadAt        DateTime?

  deals         Deal[]         @relation("DealOwner")
  notes         Note[]
  importBatches ImportBatch[]
  commissions   Commission[]
  emailAccounts EmailAccount[]
  goals         Goal[]         @relation("GoalOwner")
  createdGoals  Goal[]         @relation("GoalCreatedBy")
  standaloneContracts StandaloneContract[]
  tasksAssigned Task[] @relation("TaskAssignee")
  tasksCreated  Task[] @relation("TaskCreatedBy")
  taskComments  TaskComment[]
  activityEvents ActivityEvent[]
  leadFilters   LeadFilter[]
  watchedUrls   WatchedUrl[]
  emailTemplates EmailTemplate[]
  callLists     CallList[]
  newsPosts     NewsPost[]
}

/// One entry per notable thing that happened in the CRM (deal created,
/// meeting booked, contract sent/signed, deal went live/lost, task
/// completed, ...) - feeds the "Seneste aktivitet" newsboard on the
/// dashboard. `message` is the fully-rendered Danish sentence at the time of
/// the event (e.g. "Gustav sendte en kontrakt til Grøn Have A/S"), so the
/// feed still reads correctly even if the deal or user is later renamed or
/// removed - `actor`/`deal` are only kept for avatars/links and are safe to
/// lose (SetNull) without breaking the historical text.
model ActivityEvent {
  id      String  @id @default(cuid())
  type    String
  message String

  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A monthly target, either for one seller (userId set) or for the whole
/// company (userId null), tracked live against that month's deal data for
/// the chosen metric. Anyone can set their own; only an admin can set a
/// company-wide goal or one for someone else.
model Goal {
  id          String     @id @default(cuid())
  user        User?      @relation("GoalOwner", fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  /// First day of the target month, e.g. 2026-09-01.
  month       DateTime
  metric      GoalMetric
  targetValue Int

  createdBy   User   @relation("GoalCreatedBy", fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A daily batch of pasted leads (CVR-opslag, Facebook-sider, hjemmesider, ...)
/// to ringe igennem i én omgang - erstatter den tidligere arbejdsgang med at
/// dele links i en WhatsApp-gruppe, så leadsene i stedet lander som rigtige
/// Deals man kan filtrere til "dagens liste" og markere hurtigt tabt/booket.
model CallList {
  id          String   @id @default(cuid())
  name        String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  deals             Deal[]
  /// Lead filters set to auto-feed their daily finds into this specific list.
  targetingFilters  LeadFilter[]
}

/// A "what's new" post shown on the /nyheder blog - lets an admin announce a
/// new feature to the rest of the team (with an optional screenshot and
/// usage notes) instead of explaining it ad hoc, and drives the unread-badge
/// on the header's news icon.
model NewsPost {
  id            String   @id @default(cuid())
  title         String
  body          String
  /// Small resized screenshot, stored the same way as User.avatarUrl (a data
  /// URL, client-side resized before upload) - no file storage needed for
  /// the modest volume of feature-announcement screenshots this produces.
  screenshotUrl String?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
}

model ImportBatch {
  id           String     @id @default(cuid())
  importType   ImportType
  fileName     String?
  sourceUrl    String?
  importedBy   User       @relation(fields: [importedById], references: [id])
  importedById String
  createdAt    DateTime   @default(now())

  deals Deal[]
}

model Deal {
  id           String  @id @default(cuid())
  companyName  String
  /// Kaldenavn - shown instead of companyName wherever the deal appears, for
  /// when the CVR-registered legal name differs from what the customer is
  /// actually known as.
  displayName  String?
  cvrNumber    String?
  address      String?
  /// Geocoded from address (Danish addresses only, via DAWA) - filled in lazily
  /// the first time the customer map needs it, then cached here.
  latitude     Float?
  longitude    Float?
  contactName  String?
  contactEmail String?
  contactPhone String?
  /// Where invoices should be sent, if different from contactEmail (e.g. an accounting inbox).
  invoiceEmail String?
  /// The lead's own website/source link - captured automatically when added
  /// via Ringeliste from a pasted URL, and editable there too.
  websiteUrl   String?

  owner   User   @relation("DealOwner", fields: [ownerId], references: [id])
  ownerId String

  /// Links this deal as a branch/department of another deal (customer) - e.g.
  /// several locations of the same chain - while each keeps its own CVR
  /// number, contract, and invoicing independently.
  parent       Deal?   @relation("DealBranches", fields: [parentDealId], references: [id])
  parentDealId String?
  branches     Deal[]  @relation("DealBranches")

  stage DealStage @default(LEAD)

  meetingDate           DateTime?
  /// Length of the booked meeting in minutes (30/45/60, chosen when the
  /// calendar invite is sent) - also used to compute "timer i møder" stats.
  meetingDurationMinutes Int      @default(30)
  googleCalendarEventId String?   @unique

  soldProduct   String?
  bindingMonths Int?
  saleAmount    Int?
  soldAt        DateTime?
  filmedAt      DateTime?
  liveAt        DateTime?
  churnedAt     DateTime?

  /// When the current contract term's billing clock starts (set when the
  /// deal first goes Live; reset to the renewal date on each renewal).
  billingStartDate DateTime?

  establishmentFee  Int?
  currentTermNumber Int     @default(1)
  /// Free-text terms entered on the contract-builder page when the contract was sent.
  additionalTerms   String?
  /// Exact per-product selection/quantity/price entered on the contract-builder
  /// page for the most recently sent contract - lets re-opening the builder to
  /// edit an unsigned contract pre-fill with what was actually sent, rather
  /// than guessing it back from the aggregate saleAmount/establishmentFee.
  contractProducts  Json?

  /// Notice period required to terminate (months). Editable per deal;
  /// most contracts use 6 months.
  noticePeriodMonths  Int       @default(6)
  /// When the customer/we gave notice to terminate.
  terminationNoticeAt DateTime?
  /// Computed effective end date: max(binding period end, noticeAt + noticePeriodMonths).
  /// Billing continues (rolling past the binding period if needed) until this date,
  /// after which the deal is auto-marked inactive.
  contractEndDate     DateTime?
  /// True once an admin has manually overridden contractEndDate (e.g. a
  /// negotiated exception to the usual tacit-renewal terms) - stops the
  /// automatic recompute-on-save from clobbering it. Cleared whenever a
  /// fresh opsigelse is registered or withdrawn.
  contractEndDateManual Boolean @default(false)

  importType    ImportType   @default(MANUAL)
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])
  importBatchId String?

  /// Set when this deal came from a Ringeliste quick-add (see CallList) -
  /// lets the call-queue view filter to "only today's/this list's leads"
  /// instead of showing every open deal.
  callList   CallList? @relation(fields: [callListId], references: [id], onDelete: SetNull)
  callListId String?

  dealEmailAddress String? @unique

  contractStatus     ContractStatus @default(NONE)
  /// Historical - contracts sent before the switch to the self-built PandaDoc/SignWell flows.
  pandaDocDocumentId String?        @unique
  signWellDocumentId String?        @unique
  docusealSubmissionId String?      @unique
  contractSentAt     DateTime?
  contractViewedAt   DateTime?
  contractSignedAt   DateTime?

  dineroContactGuid String?

  /// Excludes this deal from provision entirely, e.g. so the owner can stay
  /// on the deal for pipeline tracking without it generating commission.
  commissionExcluded Boolean @default(false)

  /// The customer's tour(s) on explore.nextview360.dk (MP-Space ID, e.g.
  /// "SuPVjGiRx8q") - lets the visitor-stats report be pulled for this deal
  /// without relying on fuzzy name matching. Almost always one ID, but a few
  /// customers have more than one tour under the same deal - comma-separated
  /// in that case, with the report's numbers summed across all of them.
  mpSkinId String?

  /// Defaults to quarterly - explicitly set to null to turn automatic
  /// visitor-stats reports off for a deal (the manual "Send nu" action still
  /// works regardless). See CustomerReport for the send history and
  /// customer-report-service.ts for how nextReportDueAt advances.
  reportInterval  ReportInterval? @default(QUARTERLY)
  nextReportDueAt DateTime?

  /// Extra recipients CC'd on the visitor-stats report, comma-separated.
  /// Optional - the report always goes to the deal's own contact/invoice
  /// email regardless.
  reportCcEmails String?

  /// Language the visitor-stats report is written in for this customer.
  /// Defaults to Danish for everyone; switched to English per customer as needed.
  reportLanguage ReportLanguage @default(DA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes          Note[]
  emails         EmailMessage[]
  commission     Commission?
  invoices       Invoice[]
  items          DealItem[]
  contractEvents ContractEvent[]
  tasks          Task[]
  reports        CustomerReport[]
  activityEvents ActivityEvent[]
}

/// One row per visitor-stats report attempt for a customer (manually or by
/// the scheduler) - the "last sent" history shown on the deal and in the
/// /stats overview, and what nextReportDueAt's push-back logic reads. Failed
/// attempts are recorded too (status FAILED + errorMessage), not just
/// successes - since the actual send happens in a background job the user
/// can't otherwise see, a silent failure there would look exactly like
/// nothing happened at all.
model CustomerReport {
  id         String            @id @default(cuid())
  deal       Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId     String
  sentAt     DateTime          @default(now())
  method     ReportSendMethod
  status     ReportSendStatus  @default(SENT)
  errorMessage String?
  /// Google Drive link to the generated PDF, if archiving succeeded - best-effort,
  /// same pattern as signed-contract archiving.
  pdfDriveUrl String?
  /// Set (comma-separated deal IDs) when this is a combined report for a
  /// linked customer - dealId is the parent, this lists which of its
  /// branches' stats were included in the one PDF/email. Null for an
  /// ordinary single-deal report.
  branchDealIds String?
  createdAt  DateTime          @default(now())

  @@index([dealId, sentAt])
}

/// One entry per DocuSeal webhook occurrence (sent/viewed/signed/declined/...) -
/// kept as a full history (not just the latest per type) so the contract-status
/// hover box can show e.g. every time the customer opened it, not just the first.
model ContractEvent {
  id         String   @id @default(cuid())
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId     String
  type       String
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([dealId, occurredAt])
}

/// A contract sent to a signer before any Deal exists for them yet (e.g. a
/// walk-in customer signed on the spot at an event) - carries exactly the
/// same fields a Deal would for contract purposes. Once a matching Deal is
/// created or found, linkStandaloneContractToDeal copies these fields onto
/// it and this row is deleted - it's a holding area, not permanent storage.
model StandaloneContract {
  id           String  @id @default(cuid())
  companyName  String
  displayName  String?
  cvrNumber    String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?

  soldProduct        String?
  bindingMonths      Int?
  saleAmount         Int?
  establishmentFee   Int?
  noticePeriodMonths Int     @default(6)
  additionalTerms    String?
  contractProducts   Json?
  language           String  @default("da")

  docusealSubmissionId String?        @unique
  contractStatus       ContractStatus @default(NONE)
  contractSentAt       DateTime?
  contractViewedAt     DateTime?
  contractSignedAt     DateTime?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A service/product line on a deal - optionally tied to one of the
/// customer's several physical locations - so a deal covering multiple
/// sites and/or multiple products (website, virtual tour, drone, business
/// cards, ...) can be broken down and tracked, including ones given away
/// for free.
model DealItem {
  id     String @id @default(cuid())
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String

  /// Free-text label for the site this item belongs to, if relevant (e.g. "Hovedkontor", "Filial Aarhus").
  location    String?
  productType String
  amount      Int?
  isFree      Boolean @default(false)
  /// Link to the delivered product (e.g. the Matterport tour or the live website), so it can be opened directly.
  url         String?
  /// Uploaded photo of the item, as a data URI (base64) - currently only used for
  /// Visitkort, shown as a hover preview on the Live kunder page.
  imageUrl    String?

  createdAt DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  kind      NoteKind @default(MANUAL)
  body      String
  createdAt DateTime @default(now())
}

model EmailAccount {
  id           String        @id @default(cuid())
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  provider     EmailProvider
  email        String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  connectedAt  DateTime      @default(now())

  @@unique([userId, provider])
}

model EmailMessage {
  id          String         @id @default(cuid())
  deal        Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId      String
  provider    EmailProvider
  messageId   String
  direction   EmailDirection
  fromAddress String
  toAddresses String
  /// Cc'd recipients, comma-separated - only ever set for an OUTBOUND email
  /// sent via the template composer (e.g. cc'ing a colleague on the deal).
  ccAddresses String?
  subject     String?
  bodyText    String?
  sentAt      DateTime
  createdAt   DateTime       @default(now())

  /// Set only for an OUTBOUND email sent via the template composer - the id
  /// embedded in its tracking pixel, hit when the recipient's mail client
  /// loads images (see /api/track/email-open/[trackingId]).
  trackingId String?   @unique
  openedAt   DateTime?
  openCount  Int       @default(0)

  @@unique([provider, messageId])
}

/// A reusable, shared email you can send from a deal's page (see
/// send-email-section.tsx) - {{placeholders}} are resolved against the deal
/// and the sending seller at send time (see resolveTemplatePlaceholders).
model EmailTemplate {
  id       String @id @default(cuid())
  name     String
  subject  String
  bodyHtml String

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IntegrationSetting {
  id      String  @id @default(cuid())
  key     String  @unique
  enabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model Commission {
  id         String              @id @default(cuid())
  deal       Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId     String              @unique
  seller     User                @relation(fields: [sellerId], references: [id])
  sellerId   String
  rate       Float
  baseAmount Int
  amount     Int
  frequency  CommissionFrequency
  status     CommissionStatus    @default(PENDING)
  dueDate    DateTime?
  paidAt     DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

/// A Trello-style task, optionally tied to a deal - a standalone to-do list
/// the team can also use for anything not deal-specific.
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  done        Boolean   @default(false)
  dueDate     DateTime?

  /// When set (0=søndag..6=lørdag, matching Date.getDay()), this task
  /// repeats weekly on that day - completing it advances dueDate to the
  /// next occurrence and resets done to false instead of staying checked
  /// off, so a recurring task never actually disappears from the board.
  recurringWeekday Int?

  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId String?

  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById String

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments TaskComment[]
}

model TaskComment {
  id     String @id @default(cuid())
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  body      String
  createdAt DateTime @default(now())
}

/// One row per successful (billed) call to an external AI provider - used
/// purely to enforce a daily usage cap (see checkAiNoteLimit in
/// actions/ai-notes.ts), not shown anywhere in the UI. Only successful calls
/// are recorded - a request rejected before it ever reached the provider
/// (e.g. "not configured", empty e-mail) never actually cost anything, so it
/// shouldn't count against the cap.
model AiUsageEvent {
  id        String   @id @default(cuid())
  kind      String
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

/// A saved search against the official CVR register (branche/kommune/aktiv-status) -
/// can be run on demand ("Kør nu") and, when `enabled`, is re-run daily by the
/// lead-generation cron so new matches (newly registered or newly-found
/// companies) surface on their own without anyone remembering to search again.
model LeadFilter {
  id     String @id @default(cuid())
  name   String

  /// Comma-separated free-text terms matched (any-of) against the company's
  /// branchetekst, e.g. "restaurant, café" - deliberately loose substring
  /// matching rather than exact DB07 branchekoder, since sellers think in
  /// plain words, not industry classification codes.
  industryQuery String?
  /// Comma-separated municipality names (kommune), matched any-of.
  municipality  String?
  /// Only companies with sammensatStatus "NORMAL" (still active) - almost
  /// always wanted, since a dissolved company isn't a lead.
  activeOnly    Boolean @default(true)

  /// Optional stiftelsesdato-periode (founding-date window) - lets a filter
  /// target companies founded within a specific range instead of just
  /// whichever ones happen to be the newest matches right now.
  foundedFrom DateTime?
  foundedTo   DateTime?

  /// How many matches a single run pulls from the CVR register - a single
  /// ES query either way, so raising this doesn't add extra round-trips,
  /// just a bigger page (see MAX_LEAD_FILTER_RESULTS for the hard cap).
  maxResults Int @default(50)

  enabled    Boolean   @default(true)
  lastRunAt  DateTime?

  /// When set, a daily automatic run (see runAllEnabledLeadFilters) skips
  /// the usual "Fundne leads" review step and promotes every fresh match
  /// straight to a Deal on this Ringeliste - either a brand-new list
  /// created fresh each day (autoCreateDailyList) or always this one fixed
  /// list (targetCallListId). A manual "Kør nu" click still uses this too,
  /// for the same reason: once a filter is configured to feed a list
  /// automatically, there's no reason a manual run should behave
  /// differently and dump into "Fundne leads" instead.
  autoCreateDailyList Boolean   @default(false)
  targetCallList      CallList? @relation(fields: [targetCallListId], references: [id], onDelete: SetNull)
  targetCallListId    String?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates LeadCandidate[]
}

enum LeadCandidateStatus {
  NEW
  ADDED
  DISMISSED
}

/// One company a LeadFilter has turned up. `cvrNumber` is globally unique so
/// the same company is never surfaced twice, however many filters or runs
/// would otherwise have found it again - once reviewed (added or dismissed),
/// it's done.
model LeadCandidate {
  id     String @id @default(cuid())

  filter   LeadFilter? @relation(fields: [filterId], references: [id], onDelete: SetNull)
  filterId String?
  /// Set instead of `filter` when this was found by scanning a page rather
  /// than a branche/område filter (see WatchedUrl / url-lead-scan.ts).
  sourceUrl String?

  cvrNumber    String  @unique
  companyName  String
  address      String?
  industryText String?
  /// The branche/DB07 code (e.g. "561010") behind `industryText`'s free-text
  /// description - shown alongside it so the exact registered branche is
  /// unambiguous, not just its label.
  industryCode String?
  foundedDate  DateTime?
  contactEmail String?
  contactPhone String?
  /// Only ever populated when the register's own contact-info list happens
  /// to include one - not reliably available for every company.
  website      String?
  /// The registered owner's name, when the register exposes one (mainly for
  /// sole proprietorships) - fetched via the same lookup the single-CVR
  /// "Slå op" field on a deal uses, so it's the exact same data source.
  ownerName    String?

  status LeadCandidateStatus @default(NEW)
  /// Set once turned into a real Deal via "Tilføj som deal".
  dealId String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// A page (news article, industry listing, ...) re-scanned daily for
/// mentions of a CVR number - each one found is resolved via the official
/// lookup and surfaced as a LeadCandidate the same way a LeadFilter's finds
/// are. `lastContentHash` lets a scan skip the CVR-extraction pass entirely
/// when the page hasn't changed since last time.
model WatchedUrl {
  id    String  @id @default(cuid())
  url   String
  label String?

  enabled         Boolean   @default(true)
  lastScannedAt   DateTime?
  lastContentHash String?

  /// Results of the most recent scan - shown on the "Overvågede sider" row so
  /// it's obvious what a scan actually turned up, not just that one happened.
  /// All null until the first scan runs; `lastError` is cleared on the next
  /// successful scan, so a stale failure doesn't linger forever once fixed.
  lastCvrCount         Int?
  lastArticlesScanned  Int?
  lastAddedCount       Int?
  lastError            String?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
}
