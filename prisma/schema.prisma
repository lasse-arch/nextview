generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
}

enum CommissionFrequency {
  MONTHLY
  QUARTERLY
  ONE_TIME
}

enum ImportType {
  MANUAL
  CSV
  GOOGLE_DOCS
}

enum DealStage {
  LEAD
  CONTACTED
  MEETING_BOOKED
  CONTRACT_SENT
  CONTRACT_SIGNED
  FILMED
  LIVE
  LOST
}

enum NoteKind {
  MANUAL
  AI_MEETING
}

enum GoalMetric {
  MEETINGS_BOOKED
  ESTABLISHMENT_FEE
  MRR_SOLD
  DEALS_SOLD
}

enum CommissionStatus {
  PENDING
  DUE
  PAID
}

enum EmailProvider {
  GOOGLE
  MICROSOFT
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum ContractStatus {
  NONE
  SENT
  VIEWED
  SIGNED
  DECLINED
  VOIDED
}

enum InvoiceStatus {
  PENDING
  DRAFT_CREATED
  FAILED
  /// Historical period from before the deal was imported into the CRM -
  /// already handled by the previous system, intentionally not drafted in Dinero.
  IMPORTED
  /// A seller sent this one by hand (outside Dinero-kladden), so the
  /// automated generator must never touch it either.
  SENT_MANUALLY
}

/// How often a customer's visitor-stats report (see CustomerReport) goes out
/// automatically. Null on the deal itself means reporting is off for that deal.
enum ReportInterval {
  MONTHLY
  BIMONTHLY
  QUARTERLY
}

enum ReportSendMethod {
  MANUAL
  AUTOMATIC
}

enum ReportSendStatus {
  /// A manual send's row is created with this status immediately (before the
  /// background job even starts), so the UI has something real in the
  /// database to show a loading state from - not just client-side component
  /// state that vanishes the moment the (now near-instant) action returns.
  PENDING
  SENT
  FAILED
}


model Invoice {
  id     String @id @default(cuid())
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String

  termNumber    Int           @default(1)
  /// 0 = one-time establishment fee for this term, 1+ = recurring quarter number
  quarterIndex  Int
  amount        Int
  scheduledDate DateTime
  status        InvoiceStatus @default(PENDING)

  dineroInvoiceGuid   String? @unique
  dineroInvoiceNumber String?
  failureReason       String?

  /// Set once Dinero reports the sent invoice as paid - checked on demand,
  /// not automatically, since most invoices sit as unsent drafts and have
  /// nothing to check yet.
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealId, termNumber, quarterIndex])
}

model User {
  id                String              @id @default(cuid())
  name              String
  email             String              @unique
  passwordHash      String
  role              Role                @default(SALES)
  isCommissionBased Boolean             @default(true)
  commissionRate    Float               @default(10)
  payoutFrequency   CommissionFrequency @default(MONTHLY)
  /// Profile picture as a data URL (small, resized client-side before upload).
  avatarUrl         String?
  /// Shown as the seller's contact phone on generated contracts.
  phone             String?
  /// Shown together with `name` as the seller's full name on generated contracts.
  lastName          String?
  createdAt         DateTime            @default(now())

  deals         Deal[]         @relation("DealOwner")
  notes         Note[]
  importBatches ImportBatch[]
  commissions   Commission[]
  emailAccounts EmailAccount[]
  goals         Goal[]         @relation("GoalOwner")
  createdGoals  Goal[]         @relation("GoalCreatedBy")
  standaloneContracts StandaloneContract[]
  tasksAssigned Task[] @relation("TaskAssignee")
  tasksCreated  Task[] @relation("TaskCreatedBy")
  taskComments  TaskComment[]
}

/// A monthly target, either for one seller (userId set) or for the whole
/// company (userId null), tracked live against that month's deal data for
/// the chosen metric. Anyone can set their own; only an admin can set a
/// company-wide goal or one for someone else.
model Goal {
  id          String     @id @default(cuid())
  user        User?      @relation("GoalOwner", fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  /// First day of the target month, e.g. 2026-09-01.
  month       DateTime
  metric      GoalMetric
  targetValue Int

  createdBy   User   @relation("GoalCreatedBy", fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportBatch {
  id           String     @id @default(cuid())
  importType   ImportType
  fileName     String?
  sourceUrl    String?
  importedBy   User       @relation(fields: [importedById], references: [id])
  importedById String
  createdAt    DateTime   @default(now())

  deals Deal[]
}

model Deal {
  id           String  @id @default(cuid())
  companyName  String
  /// Kaldenavn - shown instead of companyName wherever the deal appears, for
  /// when the CVR-registered legal name differs from what the customer is
  /// actually known as.
  displayName  String?
  cvrNumber    String?
  address      String?
  /// Geocoded from address (Danish addresses only, via DAWA) - filled in lazily
  /// the first time the customer map needs it, then cached here.
  latitude     Float?
  longitude    Float?
  contactName  String?
  contactEmail String?
  contactPhone String?
  /// Where invoices should be sent, if different from contactEmail (e.g. an accounting inbox).
  invoiceEmail String?

  owner   User   @relation("DealOwner", fields: [ownerId], references: [id])
  ownerId String

  /// Links this deal as a branch/department of another deal (customer) - e.g.
  /// several locations of the same chain - while each keeps its own CVR
  /// number, contract, and invoicing independently.
  parent       Deal?   @relation("DealBranches", fields: [parentDealId], references: [id])
  parentDealId String?
  branches     Deal[]  @relation("DealBranches")

  stage DealStage @default(LEAD)

  meetingDate           DateTime?
  googleCalendarEventId String?   @unique

  soldProduct   String?
  bindingMonths Int?
  saleAmount    Int?
  soldAt        DateTime?
  filmedAt      DateTime?
  liveAt        DateTime?
  churnedAt     DateTime?

  /// When the current contract term's billing clock starts (set when the
  /// deal first goes Live; reset to the renewal date on each renewal).
  billingStartDate DateTime?

  establishmentFee  Int?
  currentTermNumber Int     @default(1)
  /// Free-text terms entered on the contract-builder page when the contract was sent.
  additionalTerms   String?
  /// Exact per-product selection/quantity/price entered on the contract-builder
  /// page for the most recently sent contract - lets re-opening the builder to
  /// edit an unsigned contract pre-fill with what was actually sent, rather
  /// than guessing it back from the aggregate saleAmount/establishmentFee.
  contractProducts  Json?

  /// Notice period required to terminate (months). Editable per deal;
  /// most contracts use 6 months.
  noticePeriodMonths  Int       @default(6)
  /// When the customer/we gave notice to terminate.
  terminationNoticeAt DateTime?
  /// Computed effective end date: max(binding period end, noticeAt + noticePeriodMonths).
  /// Billing continues (rolling past the binding period if needed) until this date,
  /// after which the deal is auto-marked inactive.
  contractEndDate     DateTime?
  /// True once an admin has manually overridden contractEndDate (e.g. a
  /// negotiated exception to the usual tacit-renewal terms) - stops the
  /// automatic recompute-on-save from clobbering it. Cleared whenever a
  /// fresh opsigelse is registered or withdrawn.
  contractEndDateManual Boolean @default(false)

  importType    ImportType   @default(MANUAL)
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])
  importBatchId String?

  dealEmailAddress String? @unique

  contractStatus     ContractStatus @default(NONE)
  /// Historical - contracts sent before the switch to the self-built PandaDoc/SignWell flows.
  pandaDocDocumentId String?        @unique
  signWellDocumentId String?        @unique
  docusealSubmissionId String?      @unique
  contractSentAt     DateTime?
  contractViewedAt   DateTime?
  contractSignedAt   DateTime?

  dineroContactGuid String?

  /// Excludes this deal from provision entirely, e.g. so the owner can stay
  /// on the deal for pipeline tracking without it generating commission.
  commissionExcluded Boolean @default(false)

  /// The customer's tour on explore.nextview360.dk (MP-Space ID, e.g.
  /// "SuPVjGiRx8q") - lets the visitor-stats report be pulled for this deal
  /// without relying on fuzzy name matching.
  mpSkinId String?

  /// Defaults to quarterly - explicitly set to null to turn automatic
  /// visitor-stats reports off for a deal (the manual "Send nu" action still
  /// works regardless). See CustomerReport for the send history and
  /// customer-report-service.ts for how nextReportDueAt advances.
  reportInterval  ReportInterval? @default(QUARTERLY)
  nextReportDueAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes          Note[]
  emails         EmailMessage[]
  commission     Commission?
  invoices       Invoice[]
  items          DealItem[]
  contractEvents ContractEvent[]
  tasks          Task[]
  reports        CustomerReport[]
}

/// One row per visitor-stats report attempt for a customer (manually or by
/// the scheduler) - the "last sent" history shown on the deal and in the
/// /stats overview, and what nextReportDueAt's push-back logic reads. Failed
/// attempts are recorded too (status FAILED + errorMessage), not just
/// successes - since the actual send happens in a background job the user
/// can't otherwise see, a silent failure there would look exactly like
/// nothing happened at all.
model CustomerReport {
  id         String            @id @default(cuid())
  deal       Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId     String
  sentAt     DateTime          @default(now())
  method     ReportSendMethod
  status     ReportSendStatus  @default(SENT)
  errorMessage String?
  /// Google Drive link to the generated PDF, if archiving succeeded - best-effort,
  /// same pattern as signed-contract archiving.
  pdfDriveUrl String?
  createdAt  DateTime          @default(now())

  @@index([dealId, sentAt])
}

/// One entry per DocuSeal webhook occurrence (sent/viewed/signed/declined/...) -
/// kept as a full history (not just the latest per type) so the contract-status
/// hover box can show e.g. every time the customer opened it, not just the first.
model ContractEvent {
  id         String   @id @default(cuid())
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId     String
  type       String
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([dealId, occurredAt])
}

/// A contract sent to a signer before any Deal exists for them yet (e.g. a
/// walk-in customer signed on the spot at an event) - carries exactly the
/// same fields a Deal would for contract purposes. Once a matching Deal is
/// created or found, linkStandaloneContractToDeal copies these fields onto
/// it and this row is deleted - it's a holding area, not permanent storage.
model StandaloneContract {
  id           String  @id @default(cuid())
  companyName  String
  displayName  String?
  cvrNumber    String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?

  soldProduct        String?
  bindingMonths      Int?
  saleAmount         Int?
  establishmentFee   Int?
  noticePeriodMonths Int     @default(6)
  additionalTerms    String?
  contractProducts   Json?
  language           String  @default("da")

  docusealSubmissionId String?        @unique
  contractStatus       ContractStatus @default(NONE)
  contractSentAt       DateTime?
  contractViewedAt     DateTime?
  contractSignedAt     DateTime?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A service/product line on a deal - optionally tied to one of the
/// customer's several physical locations - so a deal covering multiple
/// sites and/or multiple products (website, virtual tour, drone, business
/// cards, ...) can be broken down and tracked, including ones given away
/// for free.
model DealItem {
  id     String @id @default(cuid())
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String

  /// Free-text label for the site this item belongs to, if relevant (e.g. "Hovedkontor", "Filial Aarhus").
  location    String?
  productType String
  amount      Int?
  isFree      Boolean @default(false)
  /// Link to the delivered product (e.g. the Matterport tour or the live website), so it can be opened directly.
  url         String?

  createdAt DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  kind      NoteKind @default(MANUAL)
  body      String
  createdAt DateTime @default(now())
}

model EmailAccount {
  id           String        @id @default(cuid())
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  provider     EmailProvider
  email        String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  connectedAt  DateTime      @default(now())

  @@unique([userId, provider])
}

model EmailMessage {
  id          String         @id @default(cuid())
  deal        Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId      String
  provider    EmailProvider
  messageId   String
  direction   EmailDirection
  fromAddress String
  toAddresses String
  subject     String?
  bodyText    String?
  sentAt      DateTime
  createdAt   DateTime       @default(now())

  @@unique([provider, messageId])
}

model IntegrationSetting {
  id      String  @id @default(cuid())
  key     String  @unique
  enabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model Commission {
  id         String              @id @default(cuid())
  deal       Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId     String              @unique
  seller     User                @relation(fields: [sellerId], references: [id])
  sellerId   String
  rate       Float
  baseAmount Int
  amount     Int
  frequency  CommissionFrequency
  status     CommissionStatus    @default(PENDING)
  dueDate    DateTime?
  paidAt     DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

/// A Trello-style task, optionally tied to a deal - a standalone to-do list
/// the team can also use for anything not deal-specific.
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  done        Boolean   @default(false)
  dueDate     DateTime?

  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId String?

  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById String

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments TaskComment[]
}

model TaskComment {
  id     String @id @default(cuid())
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  body      String
  createdAt DateTime @default(now())
}
