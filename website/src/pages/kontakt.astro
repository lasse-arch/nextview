---
import Site from "../layouts/Site.astro";

const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://nextview360.dk/#org",
      "name": "Nextview360 ApS",
      "url": "https://nextview360.dk/",
      "logo": "https://nextview360.dk/img/logo-dark.png",
      "image": "https://nextview360.dk/img/padel.webp",
      "telephone": "+4520910294",
      "vatID": "DK46452445",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Danmarksgade 23, st.",
        "postalCode": "9000",
        "addressLocality": "Aalborg",
        "addressCountry": "DK"
      },
      "areaServed": [
        {
          "@type": "AdministrativeArea",
          "name": "Nordjylland"
        },
        {
          "@type": "Country",
          "name": "Danmark"
        }
      ],
      "founder": [
        {
          "@type": "Person",
          "name": "Lasse Sander Larsen"
        },
        {
          "@type": "Person",
          "name": "Victor Emil Rasmussen"
        }
      ],
      "knowsAbout": [
        "Virtuel rundvisning",
        "Droneoptagelser"
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Forside",
          "item": "https://nextview360.dk/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Kontakt",
          "item": "https://nextview360.dk/kontakt.html"
        }
      ]
    },
    {
      "@type": "ContactPage",
      "name": "Kontakt",
      "about": {
        "@id": "https://nextview360.dk/#org"
      }
    }
  ]
};
---
<Site title={"Kontakt Nextview360 – book et gratis møde | Aalborg"} description={"Kontakt Nextview360 på +45 20 91 02 94 eller skriv til os. Vi vender tilbage samme dag med et uforpligtende tilbud. Danmarksgade 23, st., 9000 Aalborg."} path="/kontakt.html" image={"https://nextview360.dk/img/padel.webp"} ld={ld} current="kontakt">
<main id="indhold">
<nav class="crumbs wrap" aria-label="Brødkrumme"><a href="index.html">Forside</a><span aria-hidden="true">/</span><span aria-current="page">Kontakt</span></nav><section class="khero"><div class="wrap"><div class="khero-in">
<div class="kh-l"><p class="eyebrow">Kontakt</p><h1>Lad os tage en snak</h1><p class="lead">Fortæl os kort om jeres virksomhed. Du behøver ikke vide præcis, hvad touren skal kunne. Det finder vi ud af sammen.</p>
<ul class="kh-list"><li><span>Telefon</span><a href="tel:+4520910294">+45 20 91 02 94</a></li><li><span>Adresse</span>Danmarksgade 23, st., 9000 Aalborg</li><li><span>CVR</span>46452445</li><li><span>Svartid</span>Samme dag på hverdage</li></ul></div>
<div class="kh-r"><form class="form" data-kontakt novalidate>
<label aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden">Lad dette felt være tomt<input name="website" tabindex="-1" autocomplete="off"></label>
<div class="row"><label for="k-navn">Navn *<input id="k-navn" name="navn" autocomplete="name" required></label><label for="k-firma">Virksomhed<input id="k-firma" name="firma" autocomplete="organization"></label></div>
<div class="row"><label for="k-mail">E-mail *<input id="k-mail" type="email" name="email" autocomplete="email" required></label><label for="k-tlf">Telefon<input id="k-tlf" type="tel" name="telefon" autocomplete="tel"></label></div>
<label for="k-hvad">Hvad er du interesseret i?<select id="k-hvad" name="interesse"><option>Virtuel rundvisning</option><option>Droneoptagelser</option><option>Ved ikke endnu</option></select></label>
<label for="k-besked">Besked<textarea id="k-besked" name="besked" rows="4" placeholder="Fortæl kort om jeres virksomhed"></textarea></label>
<button class="btn btn-blue" type="submit">Send</button>
<p class="note">Vi vender tilbage samme dag på hverdage.</p><p class="err" role="alert" hidden style="color:#b42318;font-weight:600"></p><p class="ok" hidden>Tak! Vi har modtaget din besked og vender tilbage hurtigst muligt.</p></form></div></div></div></section>
<section class="sec"><div class="wrap"><div class="kcards">
<article class="kcard"><h2>Kig forbi kontoret</h2><p>Vi sidder på Danmarksgade midt i Aalborg. Ring gerne i forvejen, så vi er sikre på at være hjemme og ikke ude at optage.</p><a class="txt-link" href="https://www.google.com/maps/search/?api=1&query=Danmarksgade+23,+9000+Aalborg" target="_blank" rel="noopener">Find vej på Google Maps</a></article>
<article class="kcard"><h2>Har I materiale klar?</h2><p>Logo eller billeder, vi skal bruge i touren? Skriv i formularen, så sender vi et link, hvor I kan dele filerne med os.</p><a class="txt-link" href="#k-besked">Skriv til os</a></article>
<article class="kcard"><h2>Allerede kunde?</h2><p>Skal touren opdateres, eller har I et spørgsmål? Ring direkte til din kontaktperson herunder, så hjælper vi med det samme.</p><a class="txt-link" href="#ring">Se kontaktpersoner</a></article>
</div></div></section>
<section class="sec soft" id="ring"><div class="wrap"><div class="head"><h2>Ring direkte til os</h2><p class="lead">Ingen omstilling. Du taler med dem, der optager, designer og følger op.</p></div><div class="team"><article class="member"><img src="img/gustav.webp" alt="Gustav Enström" width="779" height="973" loading="lazy"><div class="b"><h3>Gustav</h3><p class="role">Sales Manager</p><a href="tel:+4529899555">+45 29 89 95 55</a><a href="mailto:gustav@nextview360.dk">gustav@nextview360.dk</a></div></article><article class="member"><img src="img/victor.webp" alt="Victor Emil Rasmussen" width="779" height="973" loading="lazy"><div class="b"><h3>Victor</h3><p class="role">Sales & Tech Manager</p><a href="tel:+4520910294">+45 20 91 02 94</a><a href="mailto:victor@nextview360.dk">victor@nextview360.dk</a></div></article><article class="member"><img src="img/lasse.webp" alt="Lasse Sander Larsen" width="779" height="973" loading="lazy"><div class="b"><h3>Lasse</h3><p class="role">Sales & Account Manager</p><a href="tel:+4523270786">+45 23 27 07 86</a><a href="mailto:lasse@nextview360.dk">lasse@nextview360.dk</a></div></article></div></div></section>
<section class="sec"><div class="wrap"><div class="head"><h2>Hvad sker der, når du har skrevet?</h2></div><ol class="steps"><li><h3>Uforpligtende snak</h3><p>Vi tager et møde, gerne hos jer, og finder ud af, hvad der giver mening.</p></li><li><h3>Tilbud og plan</h3><p>Du får en fast pris og en tidsplan, før vi går i gang.</p></li><li><h3>Vi bygger det</h3><p>Vi optager, designer og bygger. I ser det, før det går live, og giver feedback undervejs.</p></li><li><h3>Live og opfølgning</h3><p>Vi lægger det online, sætter det op på Google og hjælper, når I har brug for det.</p></li></ol></div></section>
</main>
</Site>
