# Copy this to .env for local dev. In production (Vercel), set these as
# encrypted Environment Variables in the project settings instead - never
# commit real values.

DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Long random string (e.g. `openssl rand -base64 32`). Required. Signs session cookies.
AUTH_SECRET=""

# Base URL of the deployed app - used to build OAuth redirect URIs.
# Set to your real domain in production, e.g. https://crm.nextview360.dk
APP_BASE_URL="http://localhost:3000"

# Domain used to generate per-deal inbound email addresses (deal-xxxx@<domain>)
EMAIL_INBOUND_DOMAIN="inbox.nextview360.dk"

# --- Email integration (optional - leave empty to disable) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# --- PandaDoc contract integration (optional - leave empty to disable) ---
PANDADOC_API_KEY=""
PANDADOC_TEMPLATE_ID=""
PANDADOC_CLIENT_ROLE="Client"
# Required in production once contracts are live - see security notes in README.
PANDADOC_WEBHOOK_SHARED_KEY=""

# --- CVR lookup ---
# Official CVR register (distribution.virk.dk). Preferred when set.
CVR_API_USERNAME=""
CVR_API_PASSWORD=""
# Fallback provider (cvrapi.dk) - used automatically if the above is empty.
CVR_LOOKUP_USER_AGENT="Nextview360 CRM (kontakt: your-email@example.com)"

# --- Dinero quarterly invoice drafts (optional - leave empty to disable) ---
DINERO_CLIENT_ID=""
DINERO_CLIENT_SECRET=""
DINERO_API_KEY=""
DINERO_ORGANIZATION_ID=""
# Secures the daily cron endpoint that generates due invoice drafts.
CRON_SECRET=""

# --- Local/dev only ---
# Seeds fake demo companies + demo users. Do NOT set this in production.
SEED_DEMO_DATA="false"
